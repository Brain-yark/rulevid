# --- Backend ---
PORT=3001
# Note: Use 'db' as the host when running in Docker Compose
DATABASE_URL="postgresql://admin:password@db:5432/svsm?schema=public"
JWT_SECRET="generate_a_secure_random_string_here"

# --- Agora Credentials ---
AGORA_APP_ID="your_agora_app_id"
AGORA_APP_CERTIFICATE="your_agora_certificate"
AGORA_CUSTOMER_ID="your_agora_customer_id"
AGORA_API_KEY="your_agora_api_key"
AGORA_API_SECRET="your_agora_api_secret"

# --- Agora Chat Credentials ---
# Found in: Agora Console → Project → Chat section
AGORA_CHAT_APP_KEY="your_org_name#your_app_name"
AGORA_CHAT_ORG_NAME="your_org_name"
AGORA_CHAT_APP_NAME="your_app_name"
AGORA_CHAT_REST_API="a41.chat.agora.io"
AGORA_CHAT_WEBSOCKET="msync-api-a41.chat.agora.io"

# --- Stripe Credentials ---
STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key"
STRIPE_SECRET_KEY="your_stripe_secret_key"
# Get this from: Stripe Dashboard → Developers → Webhooks → Add endpoint
# For local testing: stripe listen --forward-to localhost:3001/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# --- Resend Email Credentials ---
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Ruleboard <onboarding@resend.dev>"

# --- Billing Integration ---
# Note: Use 'lago-api' as the host when running in Docker Compose
LAGO_API_URL="http://lago-api:3000"
LAGO_API_KEY="your_lago_api_key_here"

# --- Frontend ---
# Used for Stripe redirection success/cancel URLs
FRONTEND_URL="http://localhost:5173"
