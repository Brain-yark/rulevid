generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  companyName  String?
  sessions     Session[]
  transactions Transaction[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id               String    @id @default(uuid())
  title            String
  channelName      String    @unique
  status           String    @default("scheduled") // scheduled, active, ended
  startedAt        DateTime?
  endedAt          DateTime?
  participantCount Int       @default(0)
  facilitator      User      @relation(fields: [facilitatorId], references: [id])
  facilitatorId    String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Transaction {
  id              String   @id @default(uuid())
  type            String   // topup, deduction
  amount          Float
  currency        String   @default("USD")
  balanceAfter    Float
  description     String?
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  createdAt       DateTime @default(now())
}
