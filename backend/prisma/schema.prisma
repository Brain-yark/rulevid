generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String
  name             String?
  bio              String?
  avatarUrl        String?
  location         String?
  websiteUrl       String?
  role             String        @default("user")     // user (attendee), host (facilitator), moderator, admin, super_admin
  emailVerified    Boolean       @default(false)
  lastLoginAt      DateTime?
  companyName      String?
  walletId               String?         // Reference to Lago wallet
  stripeCustomerId       String?
  stripePaymentMethodId   String?         // Default saved payment method for 1-click & overage
  pricingTier            String          @default("standard") // standard: $0.003, premium: $0.004
  billingPackageId       String?
  billingPackage         BillingPackage? @relation(fields: [billingPackageId], references: [id])
  packageMinutesTotal    Int             @default(0)          // Purchased or granted participant-minutes for current cycle
  packageMinutesUsed     Int             @default(0)          // Consumed participant-minutes in current cycle
  packageCycleStartedAt  DateTime?
  packageCycleExpiresAt  DateTime?                            // Monthly reset date
  overageConsent         Boolean         @default(false)      // Host pre-consented to auto-charge $10 overage blocks
  status                 String          @default("active")   // active, suspended, pending
  sessions               Session[]       @relation("FacilitatorSessions")
  eventsHosted           Event[]         @relation("FacilitatorEvents")
  tickets                Ticket[]
  transactions           Transaction[]
  usageRecords           UsageRecord[]
  overageCharges         OverageCharge[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model BillingPackage {
  id                    String    @id @default(uuid())
  name                  String    // Free, Starter, Growth, Scale
  slug                  String    @unique // free, starter, growth, scale
  participantMinutes    Int       // 3000, 30000, 150000, 750000
  priceCents            Int       // 0, 3000, 13000, 0
  effectiveRatePer1k    String?   // "—", "$1.00/1k", "$0.87/1k", "negotiated"
  roughlyCovers         String?   // "~1 small event", "~10 events...", "~50 events...", "high-volume hosts"
  overageBlockCents     Int       @default(1000)  // $10 block = 1000 cents
  overageBlockMinutes   Int       @default(10000) // 10,000 participant-minutes per block
  description           String?
  isActive              Boolean   @default(true)
  isCustom              Boolean   @default(false) // true for Scale/custom
  users                 User[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model OverageCharge {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
  sessionId             String?
  amountCents           Int       // e.g. 1000 = $10.00
  minutesCredited       Int       // e.g. 10000 minutes
  stripePaymentIntentId String?
  status                String    @default("succeeded") // succeeded, failed, refunded
  receiptUrl            String?
  description           String?
  createdAt             DateTime  @default(now())
}

model Session {
  id                  String        @id @default(uuid())
  title               String
  channelName         String        @unique
  status              String        @default("scheduled") // scheduled, active, ended
  startedAt           DateTime?
  endedAt             DateTime?
  participantCount    Int           @default(0)
  totalMinutes        Int           @default(0)
  recordingUrl        String?
  recordingResourceId String?       // Agora Cloud Recording resource ID
  recordingSid        String?       // Agora Cloud Recording session ID
  agoraChatRoomId     String?       // Agora Chat Room ID
  facilitator         User          @relation("FacilitatorSessions", fields: [facilitatorId], references: [id])
  facilitatorId       String
  usageRecords        UsageRecord[]
  event               Event?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Event {
  id            String    @id @default(uuid())
  facilitator   User      @relation("FacilitatorEvents", fields: [facilitatorId], references: [id])
  facilitatorId String
  title         String
  description   String?
  startsAt      DateTime
  status        String    @default("draft") // draft, published, live, ended, cancelled
  priceCents    Int       @default(0)       // single ticket price in cents (0 = free)
  capacity      Int?                        // null = unlimited
  session       Session?  @relation(fields: [sessionId], references: [id])
  sessionId     String?   @unique
  tickets       Ticket[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Ticket {
  id                      String   @id @default(uuid())
  event                   Event    @relation(fields: [eventId], references: [id])
  eventId                 String
  user                    User     @relation(fields: [userId], references: [id])
  userId                  String
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId   String?
  status                  String   @default("pending") // pending, paid, refunded, cancelled
  amountCents             Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Transaction {
  id                 String   @id @default(uuid())
  type               String   // topup, deduction, package_subscription, overage_charge
  amount             Float
  currency           String   @default("USD")
  balanceAfter       Float
  description        String?
  lagoTransactionId  String?
  status             String   @default("completed") // pending, completed, failed
  user               User     @relation(fields: [userId], references: [id])
  userId             String
  createdAt          DateTime @default(now())
}

model UsageRecord {
  id                String    @id @default(uuid())
  minutesUsed       Int
  costToFacilitator Float
  ratePerMinute     Float
  syncedAt          DateTime?
  user              User      @relation(fields: [userId], references: [id])
  userId            String
  session           Session   @relation(fields: [sessionId], references: [id])
  sessionId         String
  createdAt         DateTime  @default(now())
}
