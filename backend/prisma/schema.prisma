generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String
  companyName      String?
  walletId         String?       // Reference to Lago wallet
  stripeCustomerId String?
  pricingTier      String        @default("standard") // standard: $0.003, premium: $0.004
  status           String        @default("active")   // active, suspended, pending
  sessions         Session[]
  transactions     Transaction[]
  usageRecords     UsageRecord[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Session {
  id               String        @id @default(uuid())
  title            String
  channelName      String        @unique
  status           String        @default("scheduled") // scheduled, active, ended
  startedAt        DateTime?
  endedAt          DateTime?
  participantCount Int           @default(0)
  totalMinutes     Int           @default(0)
  recordingUrl     String?
  facilitator      User          @relation(fields: [facilitatorId], references: [id])
  facilitatorId    String
  usageRecords     UsageRecord[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Transaction {
  id                 String   @id @default(uuid())
  type               String   // topup, deduction
  amount             Float
  currency           String   @default("USD")
  balanceAfter       Float
  description        String?
  lagoTransactionId  String?
  status             String   @default("completed") // pending, completed, failed
  user               User     @relation(fields: [userId], references: [id])
  userId             String
  createdAt          DateTime @default(now())
}

model UsageRecord {
  id               String   @id @default(uuid())
  minutesUsed      Int
  costToFacilitator Float
  ratePerMinute    Float
  syncedAt         DateTime?
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  session          Session  @relation(fields: [sessionId], references: [id])
  sessionId        String
  createdAt        DateTime @default(now())
}
